---
/* KIT — brand mark.
   A calculator whose keypad glyphs form a face: the eyes are the plus and
   multiply keys, the mouth is the union operator (∪), which is both a real
   set-theory symbol and an unambiguous smile at 20px.

   Drawn on a 32×32 grid with 2px strokes so it stays legible as a favicon.
   Body follows --c-accent so re-theming a hub re-themes the mark; --logo-body
   and --logo-glyph override that where the mark sits on a dark surface. */
interface Props {
  size?: number;
  /** accessible name; omit when a text wordmark sits next to it */
  title?: string;
}
const { size = 24, title } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 32 32"
  fill="none" xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  class="logo"
>
  {title && <title>{title}</title>}

  <rect x="5" y="1.5" width="22" height="29" rx="5.5" fill="var(--logo-body, var(--c-accent))" />

  <!-- display / brow -->
  <rect x="8.6" y="5.2" width="14.8" height="4" rx="1.3" fill="var(--logo-glyph, #fff)" opacity=".34" />

  <g stroke="var(--logo-glyph, #fff)" stroke-width="2" stroke-linecap="round">
    <!-- left eye: plus key -->
    <path d="M9.7 15h4.6M12 12.7v4.6" />
    <!-- right eye: multiply key -->
    <path d="M18.4 13.4l3.2 3.2M21.6 13.4l-3.2 3.2" />
    <!-- mouth: union operator -->
    <path d="M11.4 21.4v1.6a4.6 4.6 0 0 0 9.2 0v-1.6" stroke-linejoin="round" />
  </g>
</svg>

<style>
  .logo { display: block; flex: none; }
</style>
